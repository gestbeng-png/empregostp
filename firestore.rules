rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    function isCompany() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'empresa';
    }

    function isCandidate() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'candidato';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /profiles/{profileId} {
      allow read: if isOwner(profileId) || isAdmin();
      allow write: if false;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /applications/{applicationId} {
      allow read: if isAdmin()
        || (isCandidate() && resource.data.candidateId == request.auth.uid)
        || (isCompany() && resource.data.companyId == request.auth.uid);
      allow write: if false;
    }

    match /savedJobs/{savedJobId} {
      allow read: if signedIn() && resource.data.candidateId == request.auth.uid;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /verifications/{verificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_templates/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_guides/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_foreigners/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_premium/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_tools/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_faqs/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_services/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_courses/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_mentors/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_testimonials/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources_links/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.participants.hasAny([request.auth.uid]));
      allow write: if false;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if isAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]));
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
