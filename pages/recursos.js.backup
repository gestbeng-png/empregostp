      justifyContent: 'space-between',
      alignItems: 'center',
      padding: '1rem 1.25rem',
      cursor: 'pointer',
      transition: 'background 0.15s ease'
    },
    faqQuestionText: {
      margin: 0,
      fontSize: '0.95rem',
      fontWeight: 600,
      color: '#e4e4e7'
    },
    faqIcon: {
      width: '20px',
      height: '20px',
      color: '#71717a',
      transition: 'transform 0.2s ease'
    },
    faqAnswer: {
      padding: '0 1.25rem 1rem',
      color: '#a1a1aa',
      fontSize: '0.9rem',
      lineHeight: 1.7
    },
    linksSection: {
      display: 'grid',
      gridTemplateColumns: 'repeat(3, 1fr)',
      gap: '1.25rem'
    },
    linkCard: {
      background: 'rgba(255, 255, 255, 0.02)',
      border: '1px solid rgba(255, 255, 255, 0.06)',
      borderRadius: '12px',
      padding: '1.25rem',
      transition: 'all 0.2s ease'
    },
    linkCategory: {
      display: 'inline-block',
      padding: '0.25rem 0.6rem',
      background: 'rgba(99, 102, 241, 0.15)',
      borderRadius: '6px',
      color: '#a5b4fc',
      fontSize: '0.65rem',
      fontWeight: 700,
      textTransform: 'uppercase',
      letterSpacing: '0.05em',
      marginBottom: '0.75rem'
    },
    linkTitle: {
      margin: '0 0 0.35rem',
      fontSize: '0.95rem',
      fontWeight: 600,
      color: '#fafafa'
    },
    linkDescription: {
      margin: '0 0 0.75rem',
      color: '#71717a',
      fontSize: '0.8rem',
      lineHeight: 1.5
    },
    linkAnchor: {
      display: 'flex',
      alignItems: 'center',
      gap: '0.3rem',
      color: '#10b981',
      fontSize: '0.8rem',
      fontWeight: 600,
      textDecoration: 'none'
    },
    linkIcon: {
      width: '14px',
      height: '14px'
    },
    contactSection: {
      background: 'linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(99, 102, 241, 0.05) 100%)',
      border: '1px solid rgba(16, 185, 129, 0.2)',
      borderRadius: '20px',
      padding: '3rem',
      textAlign: 'center',
      marginTop: '3rem'
    },
    contactTitle: {
      margin: '0 0 0.75rem',
      fontSize: '1.5rem',
      fontWeight: 700,
      color: '#fafafa'
    },
    contactText: {
      margin: '0 auto 2rem',
      maxWidth: '500px',
      color: '#a1a1aa',
      fontSize: '1rem',
      lineHeight: 1.7
    },
    contactMethods: {
      display: 'flex',
      justifyContent: 'center',
      gap: '2rem',
      flexWrap: 'wrap'
    },
    contactMethod: {
      display: 'flex',
      alignItems: 'center',
      gap: '0.75rem'
    },
    contactIcon: {
      width: '44px',
      height: '44px',
      borderRadius: '12px',
      background: 'rgba(16, 185, 129, 0.15)',
      display: 'flex',
      alignItems: 'center',
      justifyContent: 'center',
      color: '#10b981'
    },
    contactIconSvg: {
      width: '22px',
      height: '22px'
    },
    contactLabel: {
      margin: 0,
      fontSize: '0.75rem',
      color: '#71717a'
    },
    contactValue: {
      margin: 0,
      fontSize: '0.95rem',
      fontWeight: 600,
      color: '#fafafa'
    }
  };

  return (
    <>
      <Head>
        <title>Recursos Gratuitos | EmpregoSTP - Templates, Guias e Ferramentas</title>
        <meta name="description" content="Recursos gratuitos para sua carreira: modelos de CV, guias de entrevista, ferramentas uteis e respostas para suas duvidas sobre emprego em Sao Tome e Principe." />
      </Head>

      <div style={styles.page}>
        <LandingHeader />

        {/* Hero */}
        <section style={styles.hero}>
          <div style={styles.heroGlow1} />
          <div style={styles.heroGlow2} />
          
          <div style={styles.container}>
            <div style={styles.heroContent}>
              <div style={styles.badge}>
                <span style={styles.badgeIcon}>{icons.folder}</span>
                <span style={styles.badgeText}>Centro de Recursos</span>
              </div>
              
              <h1 style={styles.title}>Recursos Gratuitos para sua Carreira</h1>
              <p style={styles.subtitle}>
                Templates de CV, guias praticos, ferramentas uteis e tudo que voce precisa
                para se preparar e conquistar sua proxima oportunidade.
              </p>

              <div style={styles.searchBar}>
                <span style={styles.searchIcon}>{icons.search}</span>
                <input
                  type="text"
                  placeholder="Pesquisar recursos..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  style={styles.searchInput}
                />
              </div>
            </div>
          </div>
        </section>

        {/* Templates */}
        <section style={styles.section}>
          <div style={styles.container}>
            <div style={styles.sectionHeader}>
              <h2 style={styles.sectionTitle}>
                <span style={styles.sectionIcon}>{icons.document}</span>
                Templates e Modelos
              </h2>
              <div style={styles.categories}>
                {categories.map(cat => (
                  <button
                    key={cat.id}
                    type="button"
                    onClick={() => setActiveCategory(cat.id)}
                    style={{
                      ...styles.categoryBtn,
                      ...(activeCategory === cat.id ? styles.categoryBtnActive : {})
                    }}
                  >
                    {cat.label}
                  </button>
                ))}
              </div>
            </div>

            <div style={styles.templatesGrid}>
              {filteredTemplates.map(template => (
                <div key={template.id} style={styles.templateCard}>
                  <div style={styles.templateHeader}>
                    <span style={{
                      ...styles.templateCategory,
                      background: `${template.color}15`,
                      color: template.color
                    }}>
                      {template.category}
                    </span>
                    <span style={styles.templateFormat}>{template.format}</span>
                  </div>
                  <h3 style={styles.templateTitle}>{template.title}</h3>
                  <p style={styles.templateDescription}>{template.description}</p>
                  <div style={styles.templateFooter}>
                    <span style={styles.templateDownloads}>
                      <span style={styles.templateDownloadIcon}>{icons.download}</span>
                      {template.downloads.toLocaleString('pt-PT')} downloads
                    </span>
                    <button type="button" style={styles.templateButton}>
                      <span style={styles.templateDownloadIcon}>{icons.download}</span>
                      Baixar
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* Guides */}
        <section style={{ ...styles.section, background: 'rgba(255, 255, 255, 0.01)' }}>
          <div style={styles.container}>
            <div style={styles.sectionHeader}>
              <h2 style={styles.sectionTitle}>
                <span style={styles.sectionIcon}>{icons.book}</span>
                Guias e Manuais
              </h2>
            </div>

            <div style={styles.guidesGrid}>
              {GUIDES.map(guide => (
                <div key={guide.id} style={styles.guideCard}>
                  <div style={{ ...styles.guideIcon, background: `${guide.color}15` }}>
                    <span style={{ ...styles.guideIconSvg, color: guide.color }}>{icons.book}</span>
                  </div>
                  <div style={styles.guideContent}>
                    <div style={styles.guideHeader}>
                      <span style={styles.guideCategory}>{guide.category}</span>
                      {guide.popular && <span style={styles.guidePopular}>Popular</span>}
                    </div>
                    <h3 style={styles.guideTitle}>{guide.title}</h3>
                    <p style={styles.guideDescription}>{guide.description}</p>
                    <div style={styles.guideMeta}>
                      <span style={styles.guideMetaItem}>
                        <span style={styles.guideMetaIcon}>{icons.clock}</span>
                        {guide.readTime}
                      </span>
                      <span style={styles.guideMetaItem}>
                        <span style={styles.guideMetaIcon}>{icons.file}</span>
                        {guide.pages} paginas
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* Tools */}
        <section style={styles.section}>
          <div style={styles.container}>
            <div style={styles.sectionHeader}>
              <h2 style={styles.sectionTitle}>
                <span style={styles.sectionIcon}>{icons.calculator}</span>
                Ferramentas Online
              </h2>
            </div>

            <div style={styles.toolsGrid}>
              {TOOLS.map(tool => (
                <div key={tool.id} style={styles.toolCard}>
                  <div style={{ ...styles.toolIcon, background: `${tool.color}15` }}>
                    <span style={{ ...styles.toolIconSvg, color: tool.color }}>{icons[tool.icon]}</span>
                  </div>
                  <h3 style={styles.toolTitle}>{tool.title}</h3>
                  <p style={styles.toolDescription}>{tool.description}</p>
                  <button type="button" style={styles.toolButton}>
                    Usar Ferramenta
                    <span style={{ width: '14px', height: '14px' }}>{icons.chevronRight}</span>
                  </button>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* FAQ */}
        <section style={{ ...styles.section, background: 'rgba(255, 255, 255, 0.01)' }}>
          <div style={styles.container}>
            <div style={{ ...styles.sectionHeader, marginBottom: '1.5rem' }}>
              <h2 style={styles.sectionTitle}>
                <span style={styles.sectionIcon}>{icons.help}</span>
                Perguntas Frequentes
              </h2>
            </div>

            <div style={styles.faqSection}>
              <div style={styles.faqList}>
                {FAQS.map(faq => (
                  <div key={faq.id} style={styles.faqItem}>
                    <div 
                      style={styles.faqQuestion}
                      onClick={() => setExpandedFaq(expandedFaq === faq.id ? null : faq.id)}
                    >
                      <p style={styles.faqQuestionText}>{faq.question}</p>
                      <span style={{
                        ...styles.faqIcon,
                        transform: expandedFaq === faq.id ? 'rotate(180deg)' : 'rotate(0)'
                      }}>
                        {icons.chevronDown}
                      </span>
                    </div>
                    {expandedFaq === faq.id && (
                      <div style={styles.faqAnswer}>{faq.answer}</div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        {/* External Links */}
        <section style={styles.section}>
          <div style={styles.container}>
            <div style={styles.sectionHeader}>
              <h2 style={styles.sectionTitle}>
                <span style={styles.sectionIcon}>{icons.link}</span>
                Links Uteis
              </h2>
            </div>

            <div style={styles.linksSection}>
              {LINKS.map(link => (
                <div key={link.id} style={styles.linkCard}>
                  <span style={styles.linkCategory}>{link.category}</span>
                  <h3 style={styles.linkTitle}>{link.title}</h3>
                  <p style={styles.linkDescription}>{link.description}</p>
                  <a href={link.url} target="_blank" rel="noopener noreferrer" style={styles.linkAnchor}>
                    Visitar site
                    <span style={styles.linkIcon}>{icons.chevronRight}</span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* Contact */}
        <section style={styles.section}>
          <div style={styles.container}>
            <div style={styles.contactSection}>
              <h2 style={styles.contactTitle}>Precisa de ajuda?</h2>
              <p style={styles.contactText}>
                Nao encontrou o que procura? Nossa equipa esta pronta para ajudar
                com suas duvidas sobre emprego e carreira.
              </p>
              <div style={styles.contactMethods}>
                <div style={styles.contactMethod}>
                  <div style={styles.contactIcon}>
                    <span style={styles.contactIconSvg}>{icons.mail}</span>
                  </div>
                  <div>
                    <p style={styles.contactLabel}>Email</p>
                    <p style={styles.contactValue}>suporte@empregostp.st</p>
                  </div>
                </div>
                <div style={styles.contactMethod}>
                  <div style={styles.contactIcon}>
                    <span style={styles.contactIconSvg}>{icons.phone}</span>
                  </div>
                  <div>
                    <p style={styles.contactLabel}>Telefone</p>
                    <p style={styles.contactValue}>+239 222 1234</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <Footer />
      </div>

      <style jsx>{`
        @media (max-width: 1024px) {
          .templates-grid { grid-template-columns: repeat(2, 1fr) !important; }
          .tools-grid { grid-template-columns: repeat(2, 1fr) !important; }
          .links-section { grid-template-columns: repeat(2, 1fr) !important; }
        }
        @media (max-width: 768px) {
          .templates-grid { grid-template-columns: 1fr !important; }
          .guides-grid { grid-template-columns: 1fr !important; }
          .tools-grid { grid-template-columns: 1fr !important; }
          .links-section { grid-template-columns: 1fr !important; }
        }
      `}</style>
    </>
  );
}
