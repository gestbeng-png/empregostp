rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isAdmin() {
      return isAuthenticated()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    // Limites de upload (secção 69 do fecho). Alinhados com o que cada ecrã
    // aceita; o cliente mostra o erro antes, a regra impede quem o contorna.
    // SVG fica de fora: é XML que pode levar scripts.
    function underMb(mb) { return request.resource.size < mb * 1024 * 1024; }
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif|heic|heif)');
    }
    function isPdf() { return request.resource.contentType == 'application/pdf'; }
    function isWord() {
      return request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    }
    
    // Regras que você pediu
    match /company-covers/{userId}/{allPaths=**} {
      allow read: if true;
      allow delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId) && underMb(10) && isImage();
    }
    match /company-logos/{userId}/{allPaths=**} {
      allow read: if true;
      allow delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId) && underMb(10) && isImage();
    }
    match /job-tdr/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId) && underMb(10) && (isPdf() || isWord());
    }
    // Ficheiros dos recursos carregados no admin (ver dashboard/admin/resources).
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId) && underMb(15)
        && (isPdf() || isWord() || request.resource.contentType == 'text/plain');
    }

    // --- Ficheiros pessoais do candidato ---
    //
    // Leitura restrita ao dono e a administradores. As empresas NÃO leem por
    // estas regras: o acesso legítimo passa por POST /api/files/candidate-cv,
    // que reavalia plano e privacidade e devolve um URL assinado de curta
    // duração. O Admin SDK ignora estas regras, por isso a rota continua a
    // funcionar depois de as apertar.
    //
    // ⚠️ SEQUÊNCIA DE DEPLOY OBRIGATÓRIA: o código com URLs assinados tem de
    // estar em produção e validado ANTES destas regras. Ao contrário, os CVs
    // dos utilizadores reais deixam de abrir. Ver docs/DEPLOY-GUIDE.md.
    match /cvUrl/{userId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId) && underMb(10) && (isPdf() || isWord());
    }
    match /certificados/{userId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId) && underMb(10) && (isPdf() || isImage());
    }

    // Documentos anexados a uma candidatura (registo criminal, atestado
    // médico, BI...). Mesma regra dos restantes ficheiros pessoais: a empresa
    // NÃO lê por aqui. O acesso legítimo passa por
    // POST /api/files/application-document, que confirma que quem pede é dono
    // da vaga a que a candidatura pertence.
    match /candidaturas/{userId}/{jobId}/{fileName} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated()
        && isOwner(userId)
        && underMb(10)
        && (isPdf() || isWord() || isImage());
    }

    // A fotografia de perfil é exibida em páginas públicas de candidatos
    // (perfil e listagens) através de <Image src>, sem sessão. Continua
    // legível; a privacidade do perfil é aplicada a montante, decidindo se a
    // página é servida de todo.
    match /photoUrl/{userId}/{fileName} {
      allow read: if true;
      allow delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId) && underMb(10) && isImage();
    }

    // Documentos de Verificação (ADICIONADO)
    match /verification/{docType}/{userId}/{fileName} { 
      allow read: if isAuthenticated() && isOwner(userId); 
      allow delete: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId) && underMb(10) && (isPdf() || isImage());
    }

    // Comprovativos de pagamento (assinaturas/planos)
    // Sensível: somente o dono e admins podem ler/gerar download URL.
    match /payment-proofs/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAuthenticated()
        && isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }
    
    // Bloqueia o resto
    match /{allPaths=**} { allow read, write: if false; }
  }
}
