{
  "version": 2,
  "name": "empregostp",
  "ignoreCommand": "node -e \"process.exit((process.env.VERCEL_GIT_COMMIT_MESSAGE || '').includes('[skip vercel]') ? 0 : 1)\"",
  "crons": [
    {
      "path": "/api/cron/check-plan-expiration",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/check-job-expiration",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/account-deletions",
      "schedule": "45 2 * * *"
    }
  ]
}
