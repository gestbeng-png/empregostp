{
  "name": "empregostp",
  "version": "1.0.0",
  "private": true,
  "description": "EmpregosSTP - Plataforma de vagas de emprego em São Tomé e Príncipe",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "generate:firebase-sw-config": "node --import ./scripts/preloadEnv.mjs scripts/generate-firebase-sw-config.mjs",
    "predev": "npm run generate:firebase-sw-config",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run typecheck && npm run lint && npm run test",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:firebase-online": "node --import ./scripts/preloadEnv.mjs scripts/ops/audit-data.mjs --firestore",
    "gen:env": "node scripts/generate-env.mjs",
    "test:email": "node scripts/test-email.mjs",
    "check:email-dns": "node scripts/check-email-dns.mjs",
    "preview:emails": "node scripts/preview-emails.mjs",
    "test:auth-emails": "node scripts/test-auth-emails.mjs",
    "firestore:index": "node scripts/create-firestore-index.js",
    "firestore:index:open": "node scripts/open-index-link.js",
    "prebuild": "npm run generate:firebase-sw-config"
  },
  "keywords": [
    "empregos",
    "vagas",
    "são tomé",
    "empregostp"
  ],
  "author": "Edmir dos Santos",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vercel/speed-insights": "^2.0.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "jspdf": "^4.2.1",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "nookies": "^2.5.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "recharts": "^3.9.2",
    "sanitize-html": "^2.17.5",
    "stripe": "22.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "firebase-tools": "^15.1.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.17",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
