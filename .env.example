# EmpregoSTP — variáveis de ambiente
#
# Copiar para .env.local (desenvolvimento) ou configurar no painel da Vercel.
# Nunca pôr valores reais neste ficheiro. Documentação: docs/closure/ENVIRONMENT.md
#
# [OBRIGATÓRIA]  o build de produção falha sem ela (lib/productionEnv.mjs)
# [UMA DE]       basta um dos grupos do bloco
# [OPCIONAL]     tem valor por omissão ou desliga só uma funcionalidade
#
# Atenção: com o .env.local a apontar para o projeto Firebase de produção,
# `npm run dev`, o build e os E2E leem e escrevem dados reais.

# ---------------------------------------------------------------------------
# Firebase — cliente (público: entra no bundle do browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=                 # [OBRIGATÓRIA]
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=             # [OBRIGATÓRIA] ex.: <projeto>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=              # [OBRIGATÓRIA]
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=          # [OBRIGATÓRIA] ex.: <projeto>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=     # [OBRIGATÓRIA]
NEXT_PUBLIC_FIREBASE_APP_ID=                  # [OBRIGATÓRIA]
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=          # [OPCIONAL] Analytics do Firebase
NEXT_PUBLIC_FIREBASE_VAPID_KEY=               # [OPCIONAL] notificações push no browser

# ---------------------------------------------------------------------------
# Firebase — Admin SDK (secreto: só servidor)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=                          # [OBRIGATÓRIA]
FIREBASE_CLIENT_EMAIL=                        # [OBRIGATÓRIA] conta de serviço
FIREBASE_PRIVATE_KEY=                         # [OBRIGATÓRIA] entre aspas, com \n nas quebras de linha
FIREBASE_STORAGE_BUCKET=                      # [OPCIONAL] por omissão usa NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=                         # [OPCIONAL] por omissão https://empregostp.com (links em emails, sitemap, canonical)
SITE_URL=                                     # [OPCIONAL] alias antigo de NEXT_PUBLIC_SITE_URL

# ---------------------------------------------------------------------------
# Tarefas agendadas (Vercel Cron e workflow GitHub "Recruitment scheduled tasks")
# ---------------------------------------------------------------------------
CRON_SECRET=                                  # [OBRIGATÓRIA] Bearer exigido por /api/cron/*
V2_OUTBOX_PROCESSOR_ENABLED=                  # [OPCIONAL] "true" arma /api/cron/process-outbox
V2_ATS_CRON_ENABLED=                          # [OPCIONAL] "true" arma ats-daily e interview-reminders
V2_OFFER_EXPIRY_ENABLED=                      # [OPCIONAL] "true" arma expire-offers

# ---------------------------------------------------------------------------
# Email transacional — [UMA DE] (ordem de preferência em lib/email.js)
# ---------------------------------------------------------------------------
BREVO_API_KEY=                                # grupo 1: API HTTP da Brevo (recomendado)
BREVO_SMTP_LOGIN=                             # grupo 2: relay SMTP da Brevo
BREVO_SMTP_KEY=
BREVO_SMTP_HOST=                              # [OPCIONAL] por omissão smtp-relay.brevo.com
BREVO_SMTP_PORT=                              # [OPCIONAL] por omissão 587
ZOHO_SMTP_USER=                               # grupo 3: SMTP do Zoho
ZOHO_SMTP_PASSWORD=
ZOHO_SMTP_HOST=                               # [OPCIONAL]
ZOHO_SMTP_PORT=                               # [OPCIONAL]
GMAIL_USER=                                   # grupo 4: Gmail (só recurso)
GMAIL_APP_PASSWORD=

EMAIL_FROM_ADDRESS=                           # [OBRIGATÓRIA] remetente (ex.: contacto@empregostp.com); só dispensável com GMAIL_USER
EMAIL_FROM_NAME=                              # [OPCIONAL]
EMAIL_REPLY_TO=                               # [OPCIONAL]
CONTACT_INBOX=                                # [OPCIONAL] destino do formulário /contacto (por omissão contacto@empregostp.com)

# ---------------------------------------------------------------------------
# Segurança
# ---------------------------------------------------------------------------
RATE_LIMIT_HASH_SECRET=                       # [OPCIONAL, recomendada] sal dos limites anti-abuso; sem ela usa um valor derivado do id do projeto, que é previsível
TEAM_INVITE_SECRET=                           # [OPCIONAL] só para convites de equipa (área retirada, ADR-019)

# ---------------------------------------------------------------------------
# Funcionalidades
# ---------------------------------------------------------------------------
GEMINI_API_KEY=                               # [OPCIONAL] /api/career-advice; sem ela devolve dicas genéricas
NEXT_PUBLIC_RECRUITMENT_WORKSPACE_ENABLED=    # [OPCIONAL] "true" volta a mostrar Recrutamento e equipa (ADR-019) — não ligar sem decisão do dono
# As flags V2_* do produto NÃO são variáveis de ambiente: vivem na coleção
# Firestore `featureFlags` (desligadas quando o documento não existe).

# ---------------------------------------------------------------------------
# Só desenvolvimento — nunca em produção
# ---------------------------------------------------------------------------
ENABLE_DEV_SEED_PAGE=                         # "true" abre /setup/seed (o build de produção recusa)
NEXT_DIST_DIR=                                # pasta de build alternativa (ex.: builds isolados)
FIREBASE_SW_CONFIG_OUTPUT=                    # caminho alternativo do public/firebase-sw-config.js
